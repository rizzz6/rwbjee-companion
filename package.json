        "next-themes": "^0.4.6",
        "payload": "^3.79.0",
        "react": "^19.2.1",
        "react-chartjs-2": "^5.3.0",
        "react-dom": "^19.2.1",
        "react-icons": "^5.5.0",
        "sharp": "^0.34.5",
        "swr": "^2.3.8",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "undici": "7.18.2"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "16.2.0-canary.10",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^20",
