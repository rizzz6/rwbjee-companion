        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "@typescript-eslint/parser": "^8.48.0",
        "dotenv": "^17.3.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.0-canary.10",
        "eslint-plugin-oxlint": "^1.51.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "jsdom": "^20.0.3",
        "oxfmt": "^0.36.0",
        "oxlint": "^1.51.0",
        "playwright": "^1.58.2",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "typescript": "^5"
    },
    "browserslist": [
        "defaults",
        "supports es6-module",
        "not dead",
        "not op_mini all"
    ],
    "overrides": {
