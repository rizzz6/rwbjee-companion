{
    "name": "main-site",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npm run build:metadata && npm run build:mobile && npm run build:desktop && next build",
        "start": "next start",
        "lint": "oxlint . && eslint .",
        "lint:fix": "oxlint --fix",
        "lint:all": "oxlint --type-aware --type-check",
        "indexnow": "node scripts/seo/submit-indexnow.mjs",
        "generate:importmap": "payload generate:importmap",
        "seed:upstash": "tsx scripts/database/seed-upstash.ts",
        "seed:payload:colleges": "npx dotenv-cli -e .env.local -- tsx scripts/database/seed-payload-colleges.ts",
        "seed:payload:cutoffs": "npx dotenv-cli -e .env.local -- tsx scripts/database/seed-payload-cutoffs.ts",
        "import:csv": "tsx scripts/database/import-from-csv.ts",
        "import:sheets": "tsx scripts/database/import-from-sheets-url.ts",
        "clear:supabase": "tsx scripts/database/clear-supabase.ts",
        "build:metadata": "tsx scripts/build/build-metadata.ts",
        "build:mobile": "tsx scripts/build/generate-static-slices.ts",
        "build:desktop": "tsx scripts/build/build-cutoffs-data.ts",
        "test:mobile": "tsx scripts/validation/test-static-slicing.ts",
        "validate:distribution": "tsx scripts/validation/analyze-distribution.ts",
        "validate:duplicates": "tsx scripts/validation/check-duplicates.ts",
        "validate:colleges": "tsx scripts/validation/compare-colleges.ts",
        "verify:all": "tsx scripts/validation/verify-all-data.ts",
        "list:colleges": "tsx scripts/validation/list-colleges.ts"
    },
